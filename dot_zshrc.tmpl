# Guard aliases/integrations so they only activate when the tool is installed
function __is_available {
  type "${1}" > /dev/null 2>&1
}

function __source_first_existing {
  local source_path
  for source_path in "$@"; do
    [ -f "$source_path" ] && source "$source_path" && return 0
  done
  return 1
}

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ ${PATH}                                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

{{ if eq .chezmoi.os "darwin" -}}
export PATH="/opt/homebrew/bin:$PATH"
export PNPM_HOME="$HOME/Library/pnpm"
{{ end -}}
export PATH="$PATH:/bin:/usr/bin"
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Rust/Cargo
if [ -x "$HOME/.cargo/bin/cargo" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# pnpm
if [ -n "$PNPM_HOME" ] && [ -d "$PNPM_HOME" ]; then
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
  if [ -d "$PNPM_HOME/bin" ]; then
    case ":$PATH:" in
      *":$PNPM_HOME/bin:"*) ;;
      *) export PATH="$PNPM_HOME/bin:$PATH" ;;
    esac
  fi
fi

# Mise
__is_available mise && eval "$(mise activate zsh)"

