# ── System Updates ───────────────────────────────────────────────────────────

# Update globally installed Rust, Go, pnpm, and tealdeer command-line tools.
function update-tools() {
  printf 'Updating Rust tools ...\n'
  if __is_available cargo-install-update; then
    cargo install-update --all --git || return 1
  elif __is_available cargo; then
    printf 'Skipping Rust tools: install cargo-update with "cargo install cargo-update" to enable updates.\n'
  else
    printf 'Skipping Rust tools: cargo is not installed.\n'
  fi

  printf '\nUpdating Go tools ...\n'
  if __is_available go; then
    local GOPROXY
    local go_tool_directory go_binary go_module go_path
    local -A installed_go_modules
    unset GOPROXY
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
    # Fedora provisioning installs Go tools into HOME/bin with an explicit GOBIN.
    go_tool_directory="$HOME/bin"
{{ else -}}
    go_tool_directory="$(go env GOBIN)" || return 1
    if [[ -z "$go_tool_directory" ]]; then
      go_path="$(go env GOPATH)" || return 1
      go_tool_directory="${go_path%%:*}/bin"
    fi
{{ end -}}

    if [[ -d "$go_tool_directory" ]]; then
      for go_binary in "$go_tool_directory"/*(N); do
        [[ -f "$go_binary" && -x "$go_binary" ]] || continue
        go_module="$(command go version -m "$go_binary" 2>/dev/null | command awk '$1 == "path" { print $2; exit }')"
        [[ -n "$go_module" ]] && installed_go_modules[$go_module]=1
      done

      if (( ${#installed_go_modules} )); then
        for go_module in ${(ok)installed_go_modules}; do
          command env GOBIN="$go_tool_directory" go install "${go_module}@latest" || return 1
        done
      else
        printf 'No Go tools with module metadata found in %s.\n' "$go_tool_directory"
      fi
    else
      printf 'No Go tool directory found at %s.\n' "$go_tool_directory"
    fi
  else
    printf 'Skipping Go tools: go is not installed.\n'
  fi

  printf '\nUpdating pnpm tools ...\n'
  if __is_available pnpm; then
    pnpm update --global || return 1
  else
    printf 'Skipping pnpm tools: pnpm is not installed.\n'
  fi

  printf '\nUpdating tealdeer ...\n'
  if __is_available tldr; then
    tldr --update || return 1
  else
    printf 'Skipping tealdeer: tldr is not installed.\n'
  fi

  printf '\nTools update complete\n'
}

# ── Multimedia ────────────────────────────────────────────────────────────────

# Convert a video to an optimised gif: video-to-gif <input> <output> [fps=10]
function video-to-gif() {
  local fps="${3:-10}"
  ffmpeg \
    -i "$1" \
    -filter_complex \
    "[0:v]setpts=0.5*PTS,fps=${fps},scale=800:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    -loop 0 \
    "$2"
}

# Download audio from a URL as mp3: rip <url>
function rip() {
  yt-dlp \
    -f bestaudio \
    --extract-audio \
    --audio-format mp3 \
    --audio-quality 0 \
    --yes-playlist \
    --add-metadata \
    "$1"
}

# Play audio or a stream without video: listen [to] <url>
function listen() {
  local url="$1"
  [[ "$1" = "to" ]] && url="$2"
  mpv --quiet --no-video "$url"
}

# ── Encoding ──────────────────────────────────────────────────────────────────

function encode64() {
  if [[ $# -eq 0 ]]; then
    base64
  else
    printf '%s' "$1" | base64
  fi
}

function decode64() {
  if [[ $# -eq 0 ]]; then
{{- if eq .chezmoi.os "darwin" }}
    base64 -D
{{- else }}
    base64 --decode
{{- end }}
  else
{{- if eq .chezmoi.os "darwin" }}
    printf '%s' "$1" | base64 -D
{{- else }}
    printf '%s' "$1" | base64 --decode
{{- end }}
  fi
}

function encodefile64() {
  if [[ -z "$1" ]]; then
    echo "Usage: encodefile64 <file>"
    return 1
  fi

  local output_file="${1}.txt"
  local temporary_output
  temporary_output="$(mktemp "${output_file}.XXXXXX")" || return 1

  if ! base64 < "$1" > "$temporary_output"; then
    rm -f "$temporary_output"
    return 1
  fi

  if ! mv -f "$temporary_output" "$output_file"; then
    rm -f "$temporary_output"
    return 1
  fi

  printf 'Encoded %s → %s\n' "$1" "$output_file"
}

# ── File Navigation ───────────────────────────────────────────────────────────

lfcd () {
  local tmp
  tmp="$(mktemp)" || return 1

  if ! lf -last-dir-path="$tmp" "$@"; then
    rm -f "$tmp"
    return 1
  fi

  if [[ -f "$tmp" ]]; then
    local dir
    if ! dir="$(<"$tmp")"; then
      rm -f "$tmp"
      return 1
    fi
    rm -f "$tmp" || return 1

    if [[ -d "$dir" ]] && [[ "$dir" != "$(pwd)" ]]; then
      cd "$dir"
    fi
  fi
}

# ── Networking ────────────────────────────────────────────────────────────────

my-ip() {
{{- if eq .chezmoi.os "darwin" }}
  # A Mac's active interface is not always en0, for example with Ethernet or a VPN.
  local default_network_interface local_ip
  default_network_interface="$(route -n get default 2>/dev/null | awk '/interface:/{ print $2; exit }')"
  if [[ -n "$default_network_interface" ]] \
    && local_ip="$(ipconfig getifaddr "$default_network_interface" 2>/dev/null)"; then
    printf 'Local:  %s\n' "$local_ip"
  fi
{{- end }}
  local public_ip
  public_ip="$(curl --fail --silent --show-error https://ipecho.net/plain)" || return 1
  printf 'Public: %s\n' "$public_ip"
}

# Return success when the SSH host is explicitly marked as supporting Mosh in ~/.ssh/config.
function __ssh_host_supports_mosh() {
  local ssh_host="$1"
  [[ -r "${HOME}/.ssh/config" ]] || return 1

  command awk -v requested_ssh_host="$ssh_host" '
    /^[[:space:]]*#/ {
      mosh_feature = tolower($0) ~ /features:.*mosh/
      next
    }
    tolower($1) == "host" {
      if (mosh_feature) {
        for (field = 2; field <= NF; field++) {
          if ($field == requested_ssh_host) found = 1
        }
      }
      mosh_feature = 0
      next
    }
    { mosh_feature = 0 }
    END { exit found ? 0 : 1 }
  ' "${HOME}/.ssh/config"
}

# Use Mosh for a single host marked with "Features: mosh"; otherwise preserve SSH exactly.
function ssh {
  if (( $# != 1 )) || ! __is_available mosh; then
    command ssh "$@"
    return
  fi

  local ssh_connection="$1"
  local ssh_host="${ssh_connection##*@}"
  if [[ -z "$ssh_host" || "$ssh_connection" == -* ]] \
    || ! __ssh_host_supports_mosh "$ssh_host"; then
    command ssh "$@"
    return
  fi

  printf 'connecting with mosh ...\n'
  command mosh "$ssh_connection"
}

