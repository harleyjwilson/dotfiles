  builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi

# zsh-autosuggestions — brew install zsh-autosuggestions
# Config must be set before sourcing the plugin
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20   # skip suggestions for long pastes
{{- if eq .chezmoi.os "darwin" }}
__source_first_existing \
  /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
{{- end }}

# fzf — modern setup via fzf --zsh (requires fzf >= 0.48)
if __is_available fzf; then
  eval "$(fzf --zsh)"
  __is_available rg && export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git/*"'
fi

# zoxide — smarter cd, replaces the z plugin (brew install zoxide)
__is_available zoxide && eval "$(zoxide init zsh)"

# atuin — enhanced shell history
__is_available atuin && eval "$(atuin init zsh)"

# thefuck
__is_available thefuck && eval "$(thefuck --alias)"

# zsh-syntax-highlighting — brew install zsh-syntax-highlighting
# Must be sourced after all integrations that create ZLE widgets.
{{- if eq .chezmoi.os "darwin" }}
__source_first_existing \
  /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}

