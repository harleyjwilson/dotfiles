# ── System Updates ───────────────────────────────────────────────────────────

{{- if eq .chezmoi.os "darwin" }}
# Upgrade apps and macOS; report when a macOS update requires a restart.
function sysup() {
  brew upgrade
  __is_available mas && mas upgrade

  local update_log softwareupdate_status
  update_log="$(mktemp)" || return 1
  sudo softwareupdate --install --all 2>&1 | tee "$update_log"
  softwareupdate_status=${pipestatus[1]}

  if (( softwareupdate_status != 0 )); then
    rm -f "$update_log"
    return "$softwareupdate_status"
  fi

  if grep -qi 'restart' "$update_log"; then
    printf 'A macOS update requires a restart.\n'
  fi
  rm -f "$update_log"
}
{{- end }}

# ── Multimedia ────────────────────────────────────────────────────────────────

# Convert a video to an optimised gif: video-to-gif <input> <output> [fps=10]
function video-to-gif() {
  local fps="${3:-10}"
  ffmpeg \
    -i "$1" \
    -filter_complex \
    "[0:v]setpts=0.5*PTS,fps=${fps},scale=800:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    -loop 0 \
    "$2"
}

# Download audio from a URL as mp3: rip <url>
function rip() {
  yt-dlp \
    -f bestaudio \
    --extract-audio \
    --audio-format mp3 \
    --audio-quality 0 \
    --yes-playlist \
    --add-metadata \
    "$1"
}

# Play audio or a stream without video: listen [to] <url>
function listen() {
  local url="$1"
  [[ "$1" = "to" ]] && url="$2"
  mpv --quiet --no-video "$url"
}

# ── Encoding ──────────────────────────────────────────────────────────────────

function encode64() {
  if [[ $# -eq 0 ]]; then
    base64
  else
    printf '%s' "$1" | base64
  fi
}

function decode64() {
  if [[ $# -eq 0 ]]; then
{{- if eq .chezmoi.os "darwin" }}
    base64 -D
{{- else }}
    base64 --decode
{{- end }}
  else
{{- if eq .chezmoi.os "darwin" }}
    printf '%s' "$1" | base64 -D
{{- else }}
    printf '%s' "$1" | base64 --decode
{{- end }}
  fi
}

function encodefile64() {
  if [[ -z "$1" ]]; then
    echo "Usage: encodefile64 <file>"
    return 1
  fi

  local output_file="${1}.txt"
  local temporary_output
  temporary_output="$(mktemp "${output_file}.XXXXXX")" || return 1

  if ! base64 < "$1" > "$temporary_output"; then
    rm -f "$temporary_output"
    return 1
  fi

  if ! mv -f "$temporary_output" "$output_file"; then
    rm -f "$temporary_output"
    return 1
  fi

  printf 'Encoded %s → %s\n' "$1" "$output_file"
}

# ── File Navigation ───────────────────────────────────────────────────────────

lfcd () {
  local tmp
  tmp="$(mktemp)" || return 1

  if ! lf -last-dir-path="$tmp" "$@"; then
    rm -f "$tmp"
    return 1
  fi

  if [[ -f "$tmp" ]]; then
    local dir
    if ! dir="$(<"$tmp")"; then
      rm -f "$tmp"
      return 1
    fi
    rm -f "$tmp" || return 1

    if [[ -d "$dir" ]] && [[ "$dir" != "$(pwd)" ]]; then
      cd "$dir"
    fi
  fi
}

# ── Networking ────────────────────────────────────────────────────────────────

my-ip() {
{{- if eq .chezmoi.os "darwin" }}
  local local_ip
  local_ip="$(ipconfig getifaddr en0)" || return 1
  printf 'Local:  %s\n' "$local_ip"
{{- end }}
  local public_ip
  public_ip="$(curl --fail --silent --show-error https://ipecho.net/plain)" || return 1
  printf 'Public: %s\n' "$public_ip"
}

