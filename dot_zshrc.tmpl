# ║ Shell Options                                                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

setopt interactivecomments  # allow # comments in interactive shell
setopt multios              # redirect to multiple streams: echo >file1 >file2
setopt long_list_jobs       # show long format for job notifications

