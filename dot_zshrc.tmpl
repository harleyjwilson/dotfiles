# Guard aliases/integrations so they only activate when the tool is installed
function __is_available {
  type "${1}" > /dev/null 2>&1
}

function __source_first_existing {
  local source_path
  for source_path in "$@"; do
    [ -f "$source_path" ] && source "$source_path" && return 0
  done
  return 1
}

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ ${PATH}                                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Keep user-installed commands ahead of system packages, without duplicate PATH entries.
typeset -U path

{{ if eq .chezmoi.os "darwin" -}}
# This configuration targets Apple Silicon, where Homebrew installs to /opt/homebrew.
path=(/opt/homebrew/bin $path)
export PNPM_HOME="$HOME/Library/pnpm"
{{ end -}}

# go install writes to GOPATH/bin, which is not always $HOME/go/bin.
go_command_directory="$HOME/go/bin"
if __is_available go; then
  detected_go_path=""
  if detected_go_path="$(go env GOPATH 2>/dev/null)" && [[ -n "$detected_go_path" ]]; then
    detected_go_command_directory="${detected_go_path%%:*}/bin"
    [[ -d "$detected_go_command_directory" ]] && go_command_directory="$detected_go_command_directory"
  fi
fi

path=(
  "$HOME/bin"
  "$go_command_directory"
  "$HOME/.cargo/bin"
  "$HOME/.local/bin"
  $path
  /bin
  /usr/bin
)
unset detected_go_command_directory detected_go_path go_command_directory
export PATH

# pnpm
if [ -n "$PNPM_HOME" ] && [ -d "$PNPM_HOME" ]; then
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
  if [ -d "$PNPM_HOME/bin" ]; then
    case ":$PATH:" in
      *":$PNPM_HOME/bin:"*) ;;
      *) export PATH="$PNPM_HOME/bin:$PATH" ;;
    esac
  fi
fi

# Mise
__is_available mise && eval "$(mise activate zsh)"

