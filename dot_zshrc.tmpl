# ║ Exports                                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Allow GPG's pinentry prompt to use the active terminal.
export GPG_TTY="$(tty)"

if __is_available nvim; then
  export EDITOR="nvim"
elif __is_available vim; then
  export EDITOR="vim"
fi

{{- if eq .chezmoi.os "darwin" }}
export PKG_CONFIG_PATH="/opt/homebrew/opt/ncurses/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export BEMENU_BACKEND=curses
{{- end }}



