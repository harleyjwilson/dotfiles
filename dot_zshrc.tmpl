# ║ Completions                                                                ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Collect all fpath entries before calling compinit exactly once
fpath=(
{{- if eq .chezmoi.os "darwin" }}
  /opt/homebrew/share/zsh/site-functions
  "$HOME/.docker/completions"
{{- end }}
  $fpath
)

autoload -Uz compinit zrecompile
if mkdir -p "$HOME/.cache/zsh"; then
  _zcompdump="$HOME/.cache/zsh/.zcompdump"
  compinit -d "$_zcompdump"
  if command mkdir "${_zcompdump}.lock" 2>/dev/null; then
    zrecompile -q -p "$_zcompdump"
    command rm -rf "${_zcompdump}.zwc.old" "${_zcompdump}.lock"
  fi
  unset _zcompdump

  zstyle ':completion:*' use-cache yes
  zstyle ':completion:*' cache-path "$HOME/.cache/zsh"
else
  compinit
fi

# Load bash completions for tools that only ship bash completion scripts
autoload -U +X bashcompinit && bashcompinit

unsetopt menu_complete   # do not autoselect the first completion entry
unsetopt flowcontrol
setopt auto_menu         # show completion menu on successive tab press
setopt complete_in_word
setopt always_to_end

zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' matcher-list 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' special-dirs true

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║ History                                                                    ║
# ╚════════════════════════════════════════════════════════════════════════════╝

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=10000000

setopt EXTENDED_HISTORY       # record timestamp and elapsed time
setopt SHARE_HISTORY          # share history across all sessions (implies INC_APPEND)
setopt HIST_EXPIRE_DUPS_FIRST # expire duplicate entries first when trimming
setopt HIST_IGNORE_ALL_DUPS   # delete older duplicates when a new one is added
setopt HIST_IGNORE_SPACE      # do not record entries starting with a space
setopt HIST_SAVE_NO_DUPS      # do not write duplicate entries to the history file
setopt HIST_VERIFY            # show expanded history before executing
setopt HIST_NO_STORE          # do not store the history/fc command itself
setopt HIST_REDUCE_BLANKS     # strip superfluous blanks from history entries

