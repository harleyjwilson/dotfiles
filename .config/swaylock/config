# Tokyo Night (night) palette; the image is displayed over the fallback color.
image=$HOME/.wallpaper
scaling=fill
color=1a1b26

# Lock indicator
inside-color=16161e
line-color=292e42
ring-color=414868
separator-color=292e42
text-color=c0caf5
text-clear-color=c0caf5
text-caps-lock-color=c0caf5
text-ver-color=7aa2f7
text-wrong-color=f7768e
key-hl-color=7aa2f7
bs-hl-color=f7768e

# Indicator states
inside-clear-color=16161e
inside-caps-lock-color=16161e
inside-ver-color=16161e
inside-wrong-color=16161e
ring-ver-color=7aa2f7
ring-wrong-color=f7768e

font=Sans
font-size=28
indicator-radius=100
indicator-thickness=12
show-failed-attempts
indicator-idle-visible
