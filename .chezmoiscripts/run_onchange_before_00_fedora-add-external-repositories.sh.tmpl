{{- if and .personal (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
#!/bin/bash
set -euo pipefail

# DNF5 plugins provide the COPR and config-manager commands
sudo dnf install --assumeyes dnf5-plugins

# COPR repositories
sudo dnf copr enable --assumeyes fuhrmann/ctop
sudo dnf copr enable --assumeyes scottames/ghostty
sudo dnf copr enable --assumeyes varlad/yazi

# Terra packages
sudo dnf install --assumeyes --nogpgcheck \
  --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' \
  terra-release

# 1Password
sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
sudo sh -c 'echo -e "[1password]\nname=1Password Stable Channel\nbaseurl=https://downloads.1password.com/linux/rpm/stable/\$basearch\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=https://downloads.1password.com/linux/keys/1password.asc" > /etc/yum.repos.d/1password.repo'

# Brave browser
sudo dnf config-manager addrepo --overwrite \
  --from-repofile https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo
{{- end }}
