#!/bin/bash
# Import the age-encrypted GPG secret-key backup when its primary key is absent.
set -euo pipefail

readonly gpg_secret_key_backup_source={{ joinPath .chezmoi.sourceDir "private_dot_gnupg/encrypted_gpg-secret-key.asc" | quote }}

if ! command -v gpg >/dev/null 2>&1; then
    echo "GPG secret-key import failed: gpg is not installed" >&2
    exit 1
fi

if [[ ! -r "${gpg_secret_key_backup_source}" ]]; then
    echo "GPG secret-key import failed: encrypted backup not found at ${gpg_secret_key_backup_source}" >&2
    exit 1
fi

if ! gpg_secret_key_fingerprint="$(
    chezmoi decrypt "${gpg_secret_key_backup_source}" \
        | gpg --batch --with-colons --import-options show-only --import \
        | awk -F: '$1 == "fpr" { print $10; exit }'
)"; then
    echo "GPG secret-key import failed: could not read the primary fingerprint from the backup" >&2
    exit 1
fi

if [[ -z "${gpg_secret_key_fingerprint}" ]]; then
    echo "GPG secret-key import failed: backup contains no primary fingerprint" >&2
    exit 1
fi

if gpg --batch --with-colons --list-secret-keys "${gpg_secret_key_fingerprint}" 2>/dev/null | grep -q '^sec:'; then
    exit 0
fi

chezmoi decrypt "${gpg_secret_key_backup_source}" | gpg --batch --import

if ! gpg --batch --with-colons --list-secret-keys "${gpg_secret_key_fingerprint}" 2>/dev/null | grep -q '^sec:'; then
    echo "GPG secret-key import failed: imported backup does not contain ${gpg_secret_key_fingerprint}" >&2
    exit 1
fi
